# Grade Report Generator — environment configuration template
# Copy this file to .env and fill in real values before starting the container:
#
#   cp .env.template .env    (Linux/macOS)
#   copy .env.template .env  (Windows)
#
# .env is excluded from version control (.gitignore).  Never commit real secrets.

# ── Initial admin account ──────────────────────────────────────────────────────
# Applied only on the first boot when the users database is empty.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe123!
ADMIN_SCHOOL=Your School Name Here

# ── Flask secret key ───────────────────────────────────────────────────────────
# Must be a long, random string.  Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Sessions are invalidated whenever this value changes.
SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET_KEY

# ── Gunicorn ───────────────────────────────────────────────────────────────────
# Number of worker processes.  A value of 2–4 is suitable for a single-tenant
# deployment.  Each worker uses ~50 MB RAM.
GUNICORN_WORKERS=2

# ── Cookie security ────────────────────────────────────────────────────────────
# Set to "true" when the app is served over HTTPS (production).
# Set to "false" for local HTTP development only.
COOKIE_SECURE=true
